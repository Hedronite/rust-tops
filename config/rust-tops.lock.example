# Pin CLI versions used to evaluate gates. Copy to repo root as rust-tops.lock.
# Bump deliberately; a silent tool upgrade is a methodology change.

[tools]
rustc = "1.91.0"
clippy = "1.91.0"
rustfmt = "1.91.0"
# cargo-nextest 0.9.145 is the release taiki-e/install-action can fetch.
# nextest-runner 0.124.0 shipped the same day (2026-09-16) and is not a
# cargo-nextest version. The old lock line named the runner.
cargo-nextest = "0.9.145"
cargo-llvm-cov = "0.9.1"
cargo-mutants = "27.1.0"
cargo-crap = "0.5.0"
cargo-deny = "0.18"
cargo-fuzz = "0.12"
proptest = "1"
kani-verifier = "0.68.0"
criterion = "0.8"
# callgrind runner: track the crate you actually install (gungraun-runner or iai-callgrind-runner)
callgrind-runner = "gungraun-runner"

[notes]
schema = "1.1.0"
installed_with = "cargo install --locked <tool>"
